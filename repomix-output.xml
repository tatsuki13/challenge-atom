<file path="prisma/schema.prisma">
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                 String            @id @default(cuid())
  displayName        String
  consentFamilyShare Boolean           @default(false)
  favoriteTopics     String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  conversations      Conversation[]
  dailyMetrics       DailyMetric[]
  riskEvents         RiskEvent[]
  memoryCandidates   MemoryCandidate[]
  memories           Memory[]
  memoryManagementActions  MemoryManagementAction[]
  memoryManagementRequests MemoryManagementRequest[]
  memoryRetrievalAudits     MemoryRetrievalAudit[]
  user                      User?
}

model User {
  id           String    @id @default(cuid())
  nameKey      String
  birthDate    DateTime  @db.Date
  passwordHash String
  profileId    String    @unique
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([nameKey, birthDate])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Conversation {
  id               String                 @id @default(cuid())
  profileId        String
  profile          Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title            String
  moodScoreStart   Int?
  moodScoreEnd     Int?
  startedAt        DateTime               @default(now())
  endedAt          DateTime?
  messages         Message[]
  riskEvents       RiskEvent[]
  decisions        ConversationDecision[]
  memoryCandidates MemoryCandidate[]
  memoryUsages     MemoryUsage[]
  memoryManagementRequests MemoryManagementRequest[]

  @@index([profileId, startedAt])
}

model Message {
  id               String                    @id @default(cuid())
  conversationId   String
  conversation     Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String
  content          String
  emotionLabel     String?
  riskLevel        String                    @default("none")
  rawContent       String?
  inputType        String                    @default("text")
  clientMessageId  String?
  createdAt        DateTime                  @default(now())
  riskEvents       RiskEvent[]
  responseDecision ConversationDecision?     @relation("DecisionResponse")
  decisionSources  DecisionSourceUtterance[] @relation("DecisionSourceMessage")
  memoryEvidence   MemoryCandidateEvidence[] @relation("MemoryCandidateSourceMessage")
  memoryUsages     MemoryUsage[]              @relation("MemoryUsageAssistantMessage")
  memoryManagementRequests MemoryManagementRequest[] @relation("MemoryManagementRequestSource")

  @@index([conversationId, createdAt])
  @@index([riskLevel])
  @@index([conversationId, clientMessageId])
}

model ConversationDecision {
  id                String                    @id @default(cuid())
  conversationId    String
  conversation      Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  responseMessageId String                    @unique
  responseMessage   Message                   @relation("DecisionResponse", fields: [responseMessageId], references: [id], onDelete: Cascade)
  listeningStrategy String?
  planSource        String
  generationSource  String
  mode              String
  mainFocus         String?
  shouldAskQuestion Boolean
  createdAt         DateTime                  @default(now())
