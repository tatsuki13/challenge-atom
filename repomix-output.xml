  if (turnPlan.eventType === "unknown") {
    if (turnPlan.topicType === "person") {
      return {
        chat: [
          `${focus}のことなんですね。身近な人の話は、少ししただけでも心に残りますね。`,
          `${focus}の話が出たんですね。誰かのことを思い浮かべるだけで、その場の空気が少し変わりますね。`,
