generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                 String            @id @default(cuid())
  displayName        String
  consentFamilyShare Boolean           @default(false)
  favoriteTopics     String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  conversations      Conversation[]
  dailyMetrics       DailyMetric[]
  riskEvents         RiskEvent[]
  memoryCandidates   MemoryCandidate[]
  memories           Memory[]
  memoryManagementActions  MemoryManagementAction[]
  memoryManagementRequests MemoryManagementRequest[]
  memoryRetrievalAudits     MemoryRetrievalAudit[]
}

model Conversation {
  id               String                 @id @default(cuid())
  profileId        String
  profile          Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title            String
  moodScoreStart   Int?
  moodScoreEnd     Int?
  startedAt        DateTime               @default(now())
  endedAt          DateTime?
  messages         Message[]
  riskEvents       RiskEvent[]
  decisions        ConversationDecision[]
  memoryCandidates MemoryCandidate[]
  memoryUsages     MemoryUsage[]
  memoryManagementRequests MemoryManagementRequest[]

  @@index([profileId, startedAt])
}

model Message {
  id               String                    @id @default(cuid())
  conversationId   String
  conversation     Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String
  content          String
  emotionLabel     String?
  riskLevel        String                    @default("none")
  rawContent       String?
  inputType        String                    @default("text")
  clientMessageId  String?
  createdAt        DateTime                  @default(now())
  riskEvents       RiskEvent[]
  responseDecision ConversationDecision?     @relation("DecisionResponse")
  decisionSources  DecisionSourceUtterance[] @relation("DecisionSourceMessage")
  memoryEvidence   MemoryCandidateEvidence[] @relation("MemoryCandidateSourceMessage")
  memoryUsages     MemoryUsage[]              @relation("MemoryUsageAssistantMessage")
  memoryManagementRequests MemoryManagementRequest[] @relation("MemoryManagementRequestSource")

  @@index([conversationId, createdAt])
  @@index([riskLevel])
  @@index([conversationId, clientMessageId])
}

model ConversationDecision {
  id                String                    @id @default(cuid())
  conversationId    String
  conversation      Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  responseMessageId String                    @unique
  responseMessage   Message                   @relation("DecisionResponse", fields: [responseMessageId], references: [id], onDelete: Cascade)
  listeningStrategy String?
  planSource        String
  generationSource  String
  mode              String
  mainFocus         String?
  shouldAskQuestion Boolean
  createdAt         DateTime                  @default(now())
  sourceUtterances  DecisionSourceUtterance[]
  memoryCandidates  MemoryCandidate[]
  memoryUsages      MemoryUsage[]
  memoryManagementRequest MemoryManagementRequest?
  memoryRetrievalAudit    MemoryRetrievalAudit?

  @@index([conversationId, createdAt])
}

model DecisionSourceUtterance {
  decisionId      String
  decision        ConversationDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  sourceMessageId String
  sourceMessage   Message              @relation("DecisionSourceMessage", fields: [sourceMessageId], references: [id], onDelete: Cascade)

  @@id([decisionId, sourceMessageId])
  @@index([sourceMessageId])
}

model MemoryCandidate {
  id                String                    @id @default(cuid())
  profileId         String
  profile           Profile                   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  conversationId    String
  conversation      Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  decisionId        String
  decision          ConversationDecision      @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  category          String
  content           String
  normalizedKey     String
  subject           String
  assertion         String
  polarity          String
  temporalScope     String
  confidence        Float
  status            String                    @default("candidate")
  extractionVersion String
  createdAt         DateTime                  @default(now())
  evidence          MemoryCandidateEvidence[]
  resolution        MemoryResolution?

  @@index([profileId, status, createdAt])
  @@index([profileId, category, normalizedKey])
  @@index([conversationId])
  @@index([decisionId])
}

model Memory {
  id                    String             @id @default(cuid())
  profileId             String
  profile               Profile            @relation(fields: [profileId], references: [id], onDelete: Restrict)
  category              String
  content               String
  normalizedKey         String
  polarity              String
  temporalScope         String
  status                String             @default("active")
  supersedesId          String?            @unique
  supersedes            Memory?            @relation("MemorySupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy          Memory?            @relation("MemorySupersession")
  createdByResolution   MemoryResolution?  @relation("ResolutionResult")
  targetedByResolutions MemoryResolution[] @relation("ResolutionTarget")
  usages                  MemoryUsage[]
  managementTargets       MemoryManagementAction[] @relation("MemoryManagementTarget")
  managementResults       MemoryManagementAction[] @relation("MemoryManagementResult")
  managementMatches       MemoryManagementRequestMatch[]
  selectedByRequests      MemoryManagementRequest[] @relation("MemoryManagementSelected")
  retrievalAuditResults   MemoryRetrievalAuditResult[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([profileId, status, createdAt])
  @@index([profileId, category, normalizedKey, status])
  @@unique([id, profileId])
}

model MemoryUsage {
  id                 String               @id @default(cuid())
  memoryId           String
  memory             Memory               @relation(fields: [memoryId], references: [id], onDelete: Restrict)
  assistantMessageId String
  assistantMessage   Message              @relation("MemoryUsageAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: Restrict)
  conversationId     String
  conversation       Conversation         @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  decisionId         String
  decision           ConversationDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  retrievalScore     Float
  usageReason        String
  usageRole          String?
  createdAt          DateTime             @default(now())

  @@unique([assistantMessageId, memoryId])
  @@index([memoryId, createdAt])
  @@index([decisionId])
  @@index([conversationId, createdAt])
}

model MemoryRetrievalAudit {
  id                   String                       @id @default(cuid())
  decisionId           String                       @unique
  decision             ConversationDecision         @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  profileId            String
  profile              Profile                      @relation(fields: [profileId], references: [id], onDelete: Restrict)
  executed             Boolean
  status               String
  requestSource        String?
  legacyPhase8Reason   String?                      @map("planNotRequestedReason")
  plannedMode          String?
  finalMode            String?
  noSearchReason       String?
  clarificationReason  String?
  categories           Json
  polarities           Json?
  temporalScopes       Json?
  activeMemoryCount    Int
  thresholdPassedCount Int
  selectedCount        Int
  failureReason        String?
  generationRejectionReason String?
  configVersion        String
  minimumScore         Float
  maxResults           Int
  maxContextCharacters Int
  attributeStrategy    String?
  createdAt            DateTime                     @default(now())
  results              MemoryRetrievalAuditResult[]

  @@unique([id, profileId])
  @@index([profileId, createdAt])
  @@index([status, createdAt])
}

model MemoryRetrievalAuditResult {
  auditId             String
  profileId           String
  audit               MemoryRetrievalAudit @relation(fields: [auditId, profileId], references: [id, profileId], onDelete: Restrict)
  memoryId            String
  memory              Memory              @relation(fields: [memoryId, profileId], references: [id, profileId], onDelete: Restrict)
  categoryMatch       Float
  normalizedKeyExact  Float
  normalizedKeyPartial Float
  contentPartial      Float
  bigramSimilarity    Float
  bigramScore         Float
  polarityMatch       Float?
  polarityMismatch    Float?
  temporalScopeMatch  Float?
  temporalScopeMismatch Float?
  finalScore          Float
  disposition         String
  createdAt           DateTime             @default(now())

  @@id([auditId, memoryId])
  @@index([memoryId, createdAt])
  @@index([profileId, disposition, createdAt])
}

model MemoryManagementAction {
  id             String   @id @default(cuid())
  requestKey     String   @unique
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Restrict)
  targetMemoryId String
  targetMemory   Memory   @relation("MemoryManagementTarget", fields: [targetMemoryId], references: [id], onDelete: Restrict)
  action         String
  resultMemoryId String?  @unique
  resultMemory   Memory?  @relation("MemoryManagementResult", fields: [resultMemoryId], references: [id], onDelete: Restrict)
  actor          String
  reasonCode     String
  createdAt      DateTime @default(now())
  managementRequest MemoryManagementRequest?

  @@index([profileId, createdAt])
  @@index([targetMemoryId, createdAt])
}

model MemoryManagementRequest {
  id                 String               @id @default(cuid())
  profileId          String
  profile            Profile              @relation(fields: [profileId], references: [id], onDelete: Restrict)
  conversationId     String
  conversation       Conversation         @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sourceMessageId    String                @unique
  sourceMessage      Message               @relation("MemoryManagementRequestSource", fields: [sourceMessageId], references: [id], onDelete: Restrict)
  decisionId         String                @unique
  decision           ConversationDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  intent             String
  category           String
  searchTerms        Json
  correctedContent   String?
  status             String               @default("pending")
  selectedMemoryId   String?
  selectedMemory     Memory?              @relation("MemoryManagementSelected", fields: [selectedMemoryId], references: [id], onDelete: Restrict)
  managementActionId String?               @unique
  managementAction   MemoryManagementAction? @relation(fields: [managementActionId], references: [id], onDelete: Restrict)
  createdAt          DateTime              @default(now())
  processedAt        DateTime?
  matches            MemoryManagementRequestMatch[]

  @@index([profileId, status, createdAt])
  @@index([conversationId])
}

model MemoryManagementRequestMatch {
  requestId String
  request   MemoryManagementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  memoryId  String
  memory    Memory @relation(fields: [memoryId], references: [id], onDelete: Restrict)
  score     Float

  @@id([requestId, memoryId])
  @@index([memoryId])
}

model MemoryResolution {
  id                    String          @id @default(cuid())
  candidateId           String          @unique
  candidate             MemoryCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  action                String
  targetMemoryId        String?
  targetMemory          Memory?         @relation("ResolutionTarget", fields: [targetMemoryId], references: [id], onDelete: Restrict)
  resultMemoryId        String?         @unique
  resultMemory          Memory?         @relation("ResolutionResult", fields: [resultMemoryId], references: [id], onDelete: Restrict)
  reasonCode            String
  actor                 String
  reviewedContent       String?
  reviewedNormalizedKey String?
  processedAt           DateTime        @default(now())

  @@index([targetMemoryId])
  @@index([action, processedAt])
}

model MemoryCandidateEvidence {
  candidateId     String
  candidate       MemoryCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  sourceMessageId String
  sourceMessage   Message         @relation("MemoryCandidateSourceMessage", fields: [sourceMessageId], references: [id], onDelete: Cascade)

  @@id([candidateId, sourceMessageId])
  @@index([sourceMessageId])
}

model DailyMetric {
  id                    String   @id @default(cuid())
  profileId             String
  profile               Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date                  DateTime
  conversationCount     Int      @default(0)
  userMessageCount      Int      @default(0)
  assistantMessageCount Int      @default(0)
  userCharCount         Int      @default(0)
  estimatedMinutes      Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([profileId, date])
}

model RiskEvent {
  id             String        @id @default(cuid())
  profileId      String
  profile        Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  riskLevel      String
  note           String
  createdAt      DateTime      @default(now())

  @@index([profileId, createdAt])
  @@index([riskLevel])
}
